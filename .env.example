# Copy this file to .env and fill in only the credentials you use.
# Non-sensitive URLs, models, paths, hardware choices, and other setup belong
# in config.yaml. Both files are loaded by run.sh, build scripts, and systemd.

# Ollama Cloud (https://ollama.com/settings/keys) -- the default LLM provider
# for the Ekko agent.
OLLAMA_API_KEY=replace-with-your-ollama-cloud-key

# OpenRouter, for testing the agent while the Ollama token is exhausted. It is
# only used when LLM_PROVIDER=openrouter is set in config.yaml; leaving a key
# here changes nothing on its own. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Exa web search (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=replace-with-your-exa-key

# Zing MP3 compatibility credentials. Upstream can rotate/reject the defaults
# mirrored by the client; set current values here without rebuilding. When
# anonymous calls are rejected, copy one complete browser Cookie header that
# includes a current zpsid. Never commit the real value.
ZING_API_KEY=
ZING_SECRET_KEY=
ZING_COOKIES=

# MinIO / S3 asset credentials
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key

# Wake-on-LAN: the secret token sent as X-WoL-Token when the agent wakes the PC.
# The non-sensitive endpoint URL lives in config.yaml (JETSON_WOL_URL); only the
# token belongs here. The token must match what the receiving /wake endpoint
# expects.
JETSON_WOL_TOKEN=replace-with-your-wol-token

# Air conditioner: the secret sent as X-AC-Token to the local jetsona-ac bridge.
# It must match JETSON_AC_TOKEN in /etc/jetsona-ac.env, which the installer
# scripts/jetsona_ac_install.sh writes (and prints once). The endpoint URL is
# non-sensitive and lives in config.yaml as JETSON_AC_URL. The LG ThinQ Personal
# Access Token itself belongs only in /etc/jetsona-ac.env -- the firmware never
# sees it.
JETSON_AC_TOKEN=replace-with-your-ac-token
