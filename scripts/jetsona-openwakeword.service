[Unit]
Description=Jetsona offline openWakeWord runtime
After=docker.service
Requires=docker.service

[Service]
Type=simple
RuntimeDirectory=jetsona-voice
RuntimeDirectoryMode=0755
ExecStart=/opt/jetson-fw/scripts/jetsona_openwakeword_run.sh
ExecStop=-/usr/bin/docker stop --time 2 jetsona-openwakeword
Restart=always
RestartSec=2

# The worker has no microphone device and no network. It only sees the custom
# wake model, the optional verifier, and a Unix socket shared with jetson_fw.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
