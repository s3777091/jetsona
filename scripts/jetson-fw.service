[Unit]
Description=Jetson Nano Ekko Lite (headless voice AI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jetson-fw
ExecStart=/opt/jetson-fw/scripts/jetson_fw_run.sh
Restart=on-failure
RestartSec=3
# Headless appliance: no display to own, no DRM/video groups needed. Run as
# root only because the INA219 UPS reads /dev/i2c-1 and the fan writes sysfs.
User=root
# Keep firmware-created files private.
UMask=0077
Environment=JETSON_FW_LOG=/var/log/jetson-fw.log
# Pin the settings store: systemd exports HOME=/root for User=root, so without
# this the boot run reads a different store than a manual launch.
Environment=JETSON_SETTINGS_FILE=/var/lib/jetson-fw/settings.kv
StandardOutput=append:/var/log/jetson-fw.log
StandardError=append:/var/log/jetson-fw.log

[Install]
WantedBy=multi-user.target